<div class="min-h-screen bg-gray-950 text-white pb-20">
  <!-- Header -->
  <header class="sticky top-0 z-20 bg-gray-900/95 backdrop-blur-sm border-b border-gray-800">
    <div class="max-w-2xl mx-auto px-4 py-4">
      <h1 class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent">
        Settings
      </h1>
    </div>
  </header>

  <main class="max-w-2xl mx-auto px-4 py-6 space-y-6">
    <!-- Change Email -->
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-6">
      <h2 class="text-lg font-semibold mb-4">Change email</h2>

      <.form let={f} for={@email_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_email" class="space-y-4">
        <%= if @email_changeset.action do %>
          <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-lg">
            <p class="text-sm text-red-400">Oops, something went wrong! Please check the errors below.</p>
          </div>
        <% end %>

        <%= hidden_input f, :action, name: "action", value: "update_email" %>

        <div>
          <%= label f, :email, class: "block text-sm font-medium text-gray-300 mb-2" %>
          <%= email_input f, :email, required: true,
            class: "w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500" %>
          <%= error_tag f, :email %>
        </div>

        <div>
          <%= label f, :current_password, "Current password", for: "current_password_for_email", class: "block text-sm font-medium text-gray-300 mb-2" %>
          <%= password_input f, :current_password, required: true, name: "current_password", id: "current_password_for_email",
            class: "w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500" %>
          <%= error_tag f, :current_password %>
        </div>

        <div>
          <%= submit "Change email",
            class: "w-full py-3 px-4 bg-purple-600 hover:bg-purple-500 text-white font-semibold rounded-lg transition-colors" %>
        </div>
      </.form>
    </div>

    <!-- Change Password -->
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-6">
      <h2 class="text-lg font-semibold mb-4">Change password</h2>

      <.form let={f} for={@password_changeset} action={Routes.user_settings_path(@conn, :update)} id="update_password" class="space-y-4">
        <%= if @password_changeset.action do %>
          <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-lg">
            <p class="text-sm text-red-400">Oops, something went wrong! Please check the errors below.</p>
          </div>
        <% end %>

        <%= hidden_input f, :action, name: "action", value: "update_password" %>

        <div>
          <%= label f, :password, "New password", class: "block text-sm font-medium text-gray-300 mb-2" %>
          <%= password_input f, :password, required: true,
            class: "w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500" %>
          <%= error_tag f, :password %>
        </div>

        <div>
          <%= label f, :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-300 mb-2" %>
          <%= password_input f, :password_confirmation, required: true,
            class: "w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500" %>
          <%= error_tag f, :password_confirmation %>
        </div>

        <div>
          <%= label f, :current_password, "Current password", for: "current_password_for_password", class: "block text-sm font-medium text-gray-300 mb-2" %>
          <%= password_input f, :current_password, required: true, name: "current_password", id: "current_password_for_password",
            class: "w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500" %>
          <%= error_tag f, :current_password %>
        </div>

        <div>
          <%= submit "Change password",
            class: "w-full py-3 px-4 bg-purple-600 hover:bg-purple-500 text-white font-semibold rounded-lg transition-colors" %>
        </div>
      </.form>
    </div>

    <!-- Household Link -->
    <a href="/household" class="block bg-gray-900 rounded-xl border border-gray-800 p-6 hover:border-purple-500/50 transition-colors">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold">Household</h2>
          <p class="text-sm text-gray-400 mt-1">Manage your household and invite roommates</p>
        </div>
        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

    <!-- Log Out -->
    <%= link to: Routes.user_session_path(@conn, :delete), method: :delete,
      class: "block w-full py-3 px-4 bg-red-600/20 hover:bg-red-600/30 text-red-400 font-medium rounded-lg transition-colors border border-red-600/30 text-center" do %>
      Log out
    <% end %>
  </main>

  <!-- Bottom Navigation -->
  <nav class="fixed bottom-0 left-0 right-0 z-30 bg-gray-900/95 backdrop-blur-lg border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center justify-around py-3">
        <a href="/" class="flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span class="text-xs font-medium">Feed</span>
        </a>
        <a href="/recipes/saved" class="flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <span class="text-xs font-medium">Saved</span>
        </a>
        <a href="/calendar" class="flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="text-xs font-medium">Calendar</span>
        </a>
        <a href="/groceries" class="flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <span class="text-xs font-medium">Groceries</span>
        </a>
        <a href="/users/settings" class="flex flex-col items-center gap-1 text-purple-400 transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
          </svg>
          <span class="text-xs font-medium">Profile</span>
        </a>
      </div>
    </div>
  </nav>
</div>
