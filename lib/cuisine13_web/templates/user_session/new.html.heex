<div class="min-h-screen bg-gray-950 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <!-- Logo -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold bg-gradient-to-r from-purple-400 to-pink-500 bg-clip-text text-transparent">
        Cuisine13
      </h1>
      <p class="text-gray-400 mt-2">Plan meals together with your household</p>
    </div>

    <!-- Form Card -->
    <div class="bg-gray-900 rounded-2xl border border-gray-800 p-8">
      <h2 class="text-2xl font-bold text-white mb-6">Welcome back</h2>

      <.form let={f} for={@conn} action={Routes.user_session_path(@conn, :create)} as={:user} class="space-y-5">
        <%= if @error_message do %>
          <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-lg">
            <p class="text-sm text-red-400"><%= @error_message %></p>
          </div>
        <% end %>

        <div>
          <%= label f, :email, class: "block text-sm font-medium text-gray-300 mb-2" %>
          <%= email_input f, :email, required: true,
            class: "w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500",
            placeholder: "you@example.com" %>
        </div>

        <div>
          <%= label f, :password, class: "block text-sm font-medium text-gray-300 mb-2" %>
          <%= password_input f, :password, required: true,
            class: "w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500",
            placeholder: "Your password" %>
        </div>

        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= checkbox f, :remember_me, class: "w-4 h-4 rounded border-gray-600 bg-gray-800 text-purple-600 focus:ring-purple-500 focus:ring-offset-gray-900" %>
            <span class="text-sm text-gray-400">Keep me logged in</span>
          </label>
          <%= link "Forgot password?", to: Routes.user_reset_password_path(@conn, :new),
            class: "text-sm text-purple-400 hover:text-purple-300" %>
        </div>

        <div>
          <%= submit "Log in",
            class: "w-full py-3 px-4 bg-purple-600 hover:bg-purple-500 text-white font-semibold rounded-lg transition-colors" %>
        </div>
      </.form>
    </div>

    <!-- Register Link -->
    <p class="text-center mt-6 text-gray-400">
      Don't have an account?
      <%= link "Create one", to: Routes.user_registration_path(@conn, :new),
        class: "text-purple-400 hover:text-purple-300 font-medium" %>
    </p>
  </div>
</div>
