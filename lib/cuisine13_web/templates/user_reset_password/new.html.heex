<div class="min-h-screen bg-gray-950 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <!-- Logo -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-white">
        Cuisine13
      </h1>
      <p class="text-gray-400 mt-2">Plan meals together with your household</p>
    </div>

    <!-- Form Card -->
    <div class="bg-gray-900 rounded-2xl border border-gray-800 p-8">
      <h2 class="text-2xl font-bold text-white mb-2">Forgot your password?</h2>
      <p class="text-gray-400 text-sm mb-6">Enter your email and we'll send you instructions to reset it.</p>

      <.form let={f} for={:user} action={Routes.user_reset_password_path(@conn, :create)} class="space-y-5">
        <div>
          <%= label f, :email, class: "block text-sm font-medium text-gray-300 mb-2" %>
          <%= email_input f, :email, required: true,
            class: "w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500",
            placeholder: "you@example.com" %>
        </div>

        <div>
          <%= submit "Send reset instructions",
            class: "w-full py-3 px-4 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg transition-colors" %>
        </div>
      </.form>
    </div>

    <!-- Links -->
    <p class="text-center mt-6 text-gray-400">
      <%= link "Back to login", to: Routes.user_session_path(@conn, :new),
        class: "text-blue-500 hover:text-blue-400 font-medium" %>
    </p>
  </div>
</div>
