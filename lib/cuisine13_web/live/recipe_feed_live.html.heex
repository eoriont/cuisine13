<div class="min-h-screen bg-gray-900 pb-20">
  <!-- Recipe Feed -->
  <div class="max-w-2xl mx-auto">
    <%= for recipe <- @recipes do %>
      <div class="relative h-screen snap-start snap-always" id={"recipe-#{recipe.id}"}>
        <!-- Recipe Image -->
        <div class="absolute inset-0">
          <%= if recipe.image_url do %>
            <img
              src={recipe.image_url}
              alt={recipe.title}
              class="w-full h-full object-cover"
            />
          <% else %>
            <div class="w-full h-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center">
              <span class="text-white text-6xl">🍽️</span>
            </div>
          <% end %>
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        </div>

        <!-- Recipe Info Overlay -->
        <div class="absolute bottom-24 left-0 right-0 px-6 text-white">
          <!-- Allergen Warning -->
          <%= if has_allergens?(recipe, @current_user) do %>
            <div class="mb-4 bg-red-500/90 backdrop-blur-sm rounded-lg px-4 py-3">
              <div class="flex items-start">
                <svg class="w-6 h-6 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <p class="font-semibold">Contains Allergens</p>
                  <p class="text-sm mt-1">
                    <%= Enum.join(get_matching_allergens(recipe, @current_user), ", ") %>
                  </p>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Recipe Title -->
          <h1 class="text-3xl font-bold mb-3 leading-tight">
            <%= recipe.title %>
          </h1>

          <!-- Recipe Details -->
          <div class="flex items-center gap-4 mb-3 text-sm">
            <%= if recipe.prep_time_minutes do %>
              <div class="flex items-center gap-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span><%= recipe.prep_time_minutes + (recipe.cook_time_minutes || 0) %> min</span>
              </div>
            <% end %>

            <%= if recipe.servings do %>
              <div class="flex items-center gap-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                <span><%= recipe.servings %> servings</span>
              </div>
            <% end %>

            <%= if recipe.difficulty do %>
              <div class="px-3 py-1 bg-white/20 backdrop-blur-sm rounded-full text-xs font-medium uppercase">
                <%= recipe.difficulty %>
              </div>
            <% end %>
          </div>

          <!-- Description -->
          <%= if recipe.description do %>
            <p class="text-sm text-gray-200 line-clamp-2 mb-4">
              <%= recipe.description %>
            </p>
          <% end %>

          <!-- View Details Button -->
          <%= live_redirect to: "/recipes/#{recipe.id}", class: "inline-block px-6 py-3 bg-white text-gray-900 font-semibold rounded-full hover:bg-gray-100 transition-colors" do %>
            View Recipe Details
          <% end %>
        </div>

        <!-- Like Button -->
        <div class="absolute bottom-32 right-6">
          <%= if recipe_liked?(recipe.id, @current_user.id) do %>
            <button
              phx-click="unlike_recipe"
              phx-value-recipe-id={recipe.id}
              class="w-14 h-14 bg-red-500 rounded-full flex items-center justify-center shadow-lg hover:bg-red-600 transition-colors"
            >
              <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
              </svg>
            </button>
          <% else %>
            <button
              phx-click="like_recipe"
              phx-value-recipe-id={recipe.id}
              class="w-14 h-14 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center shadow-lg hover:bg-white/30 transition-colors"
            >
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Load More Trigger -->
    <div
      id="load-more-trigger"
      phx-hook="InfiniteScroll"
      class="h-20"
    ></div>
  </div>

  <!-- Bottom Navigation -->
  <nav class="fixed bottom-0 left-0 right-0 bg-gray-800/95 backdrop-blur-lg border-t border-gray-700">
    <div class="max-w-2xl mx-auto px-6 py-3">
      <div class="flex items-center justify-around">
        <!-- Home -->
        <a href="/" class="flex flex-col items-center gap-1 text-purple-400">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
          </svg>
          <span class="text-xs font-medium">Feed</span>
        </a>

        <!-- Saved -->
        <%= live_redirect to: "/recipes/saved", class: "flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <span class="text-xs font-medium">Saved</span>
        <% end %>

        <!-- Calendar -->
        <%= live_redirect to: "/calendar", class: "flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="text-xs font-medium">Calendar</span>
        <% end %>

        <!-- Groceries -->
        <%= live_redirect to: "/groceries", class: "flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <span class="text-xs font-medium">Groceries</span>
        <% end %>

        <!-- Profile -->
        <%= live_redirect to: "/users/settings", class: "flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <span class="text-xs font-medium">Profile</span>
        <% end %>
      </div>
    </div>
  </nav>
</div>

<!-- Infinite Scroll Hook -->
<script>
  window.addEventListener("phx:page-loading-stop", () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const hook = entry.target.getAttribute('phx-hook');
          if (hook === 'InfiniteScroll') {
            window.dispatchEvent(new Event('load-more'));
          }
        }
      });
    }, { threshold: 0.1 });

    const trigger = document.getElementById('load-more-trigger');
    if (trigger) {
      observer.observe(trigger);
    }
  });
</script>
