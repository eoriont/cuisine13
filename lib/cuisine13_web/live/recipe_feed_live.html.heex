<div class="min-h-screen bg-gray-950 text-white">
  <!-- Header with iOS safe area -->
  <header class="mobile-header bg-gray-900/95 backdrop-blur-sm border-b border-gray-800">
    <div class="max-w-7xl mx-auto px-4 py-3">
      <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">
          Cuisine13
        </h1>
        <div class="flex items-center gap-4">
          <%= live_redirect to: "/recipes/saved", class: "relative p-2 -m-2" do %>
            <svg class="w-6 h-6 text-gray-400 hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          <% end %>
          <%= live_redirect to: "/users/settings", class: "relative p-2 -m-2" do %>
            <svg class="w-6 h-6 text-gray-400 hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          <% end %>
        </div>
      </div>

      <!-- Feed Mode Toggle -->
      <%= if @recommendation_available do %>
        <div class="flex gap-2 mt-3">
          <button
            phx-click="switch_feed_mode"
            phx-value-mode="normal"
            class={"px-4 py-2 rounded-full text-sm font-medium transition-colors " <>
              if @feed_mode == "normal", do: "bg-blue-600 text-white", else: "bg-gray-800 text-gray-400 hover:text-white"}
          >
            For You
          </button>
          <button
            phx-click="switch_feed_mode"
            phx-value-mode="steal"
            class={"px-4 py-2 rounded-full text-sm font-medium transition-colors " <>
              if @feed_mode == "steal", do: "bg-orange-600 text-white", else: "bg-gray-800 text-gray-400 hover:text-white"}
          >
            🍴 Steal Mode
          </button>
          <button
            phx-click="switch_feed_mode"
            phx-value-mode="trending"
            class={"px-4 py-2 rounded-full text-sm font-medium transition-colors " <>
              if @feed_mode == "trending", do: "bg-purple-600 text-white", else: "bg-gray-800 text-gray-400 hover:text-white"}
          >
            🔥 Trending
          </button>
        </div>
      <% end %>
    </div>
  </header>

  <!-- Recipe Grid -->
  <main class="max-w-7xl mx-auto px-4 py-6">
    <!-- Steal Mode Dishes -->
    <%= if @feed_mode == "steal" and length(@steal_dishes) > 0 do %>
      <div class="mb-8">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <span class="text-2xl">🍴</span>
          Local Restaurant Dishes
        </h2>
        <p class="text-gray-400 text-sm mb-4">Tap a dish to get a homemade recipe version!</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for dish <- @steal_dishes do %>
            <button
              phx-click="steal_dish"
              phx-value-dish-name={dish["dish_name"]}
              phx-value-restaurant={dish["restaurant_name"]}
              class="bg-gray-900 rounded-xl overflow-hidden border border-gray-800 hover:border-orange-500/50 transition-all text-left"
            >
              <div class="relative h-40">
                <%= if dish["dish_image"] do %>
                  <img src={dish["dish_image"]} alt={dish["dish_name"]} class="w-full h-full object-cover" />
                <% else %>
                  <div class="w-full h-full bg-gradient-to-br from-orange-600 to-orange-400 flex items-center justify-center">
                    <span class="text-4xl">🍽️</span>
                  </div>
                <% end %>
                <div class="absolute inset-0 bg-gradient-to-t from-gray-900 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-3">
                  <h3 class="font-bold text-white line-clamp-1"><%= dish["dish_name"] %></h3>
                  <p class="text-sm text-gray-300"><%= dish["restaurant_name"] %></p>
                </div>
              </div>
              <div class="p-3 flex items-center justify-between">
                <div class="flex items-center gap-2 text-sm text-gray-400">
                  <%= if dish["rating"] do %>
                    <span class="flex items-center gap-1">
                      <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                      <%= dish["rating"] %>
                    </span>
                  <% end %>
                  <%= if dish["distance_miles"] do %>
                    <span><%= dish["distance_miles"] %> mi</span>
                  <% end %>
                  <%= if dish["price_level"] do %>
                    <span class="text-green-400"><%= dish["price_level"] %></span>
                  <% end %>
                </div>
                <span class="text-orange-500 text-sm font-medium">Steal Recipe →</span>
              </div>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= if Enum.empty?(@recipes) do %>
      <div class="flex flex-col items-center justify-center py-20">
        <div class="text-6xl mb-4">🍽️</div>
        <h2 class="text-2xl font-semibold mb-2 text-gray-300">No Recipes Yet</h2>
        <p class="text-gray-500">Check back soon for delicious recipes!</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <%= for recipe <- @recipes do %>
          <div class="group relative bg-gray-900 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-800 hover:border-blue-500/50">
            <!-- Recipe Image -->
            <div class="relative h-64 overflow-hidden">
              <%= if recipe.image_url do %>
                <img
                  src={recipe.image_url}
                  alt={recipe.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              <% else %>
                <div class="w-full h-full bg-gradient-to-br from-blue-600 to-blue-400 flex items-center justify-center">
                  <span class="text-6xl">🍽️</span>
                </div>
              <% end %>

              <!-- Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/50 to-transparent"></div>

              <!-- Like Button -->
              <button
                phx-click="toggle_like"
                phx-value-recipe-id={recipe.id}
                class="absolute top-3 right-3 p-2 bg-black/40 backdrop-blur-sm rounded-full transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center"
              >
                <%= if recipe_liked?(recipe, @liked_recipe_ids) do %>
                  <svg class="w-6 h-6 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                  </svg>
                <% else %>
                  <svg class="w-6 h-6 text-white hover:text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                <% end %>
              </button>

              <!-- Allergen Badge -->
              <%= if has_allergens?(recipe, @current_user) do %>
                <div class="absolute top-3 left-3">
                  <div class="flex items-center gap-1.5 px-2.5 py-1.5 bg-red-500/90 backdrop-blur-sm rounded-lg text-xs font-semibold">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    Allergen
                  </div>
                </div>
              <% end %>


              <!-- Recipe Info on Image -->
              <div class="absolute bottom-0 left-0 right-0 p-4">
                <h3 class="text-xl font-bold mb-2 text-white line-clamp-2">
                  <%= recipe.title %>
                </h3>
                <div class="flex items-center gap-3 text-sm text-gray-200">
                  <%= if recipe.total_time_minutes do %>
                    <div class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <span><%= recipe.total_time_minutes %> min</span>
                    </div>
                  <% end %>
                  <%= if recipe.servings do %>
                    <div class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                      </svg>
                      <span><%= recipe.servings %></span>
                    </div>
                  <% end %>
                  <%= if recipe.difficulty do %>
                    <span class="px-2 py-0.5 bg-white/20 backdrop-blur-sm rounded-full text-xs font-medium capitalize">
                      <%= recipe.difficulty %>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-4">
              <%= if recipe.description do %>
                <p class="text-sm text-gray-400 line-clamp-2 mb-4">
                  <%= recipe.description %>
                </p>
              <% end %>

              <!-- Allergen Warning Details -->
              <%= if has_allergens?(recipe, @current_user) do %>
                <div class="mb-4 p-3 bg-red-500/10 border border-red-500/20 rounded-lg">
                  <p class="text-xs text-red-300">
                    <span class="font-semibold">Contains:</span>
                    <%= Enum.join(get_matching_allergens(recipe, @current_user), ", ") %>
                  </p>
                </div>
              <% end %>

              <!-- Action Buttons -->
              <div class="flex gap-2">
                <!-- Add to Calendar - Primary Action -->
                <button
                  phx-click="open_calendar_modal"
                  phx-value-recipe-id={recipe.id}
                  class="flex-1 py-2.5 px-4 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg transition-colors flex items-center justify-center gap-2"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  <span>Add to Calendar</span>
                </button>

                <!-- View Recipe - Secondary Action -->
                <%= live_redirect to: "/recipes/#{recipe.id}",
                  class: "flex-shrink-0 py-2.5 px-4 bg-gray-800 hover:bg-gray-700 text-white font-semibold rounded-lg transition-colors border border-gray-700 flex items-center justify-center" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Load More -->
      <div class="mt-8 flex justify-center">
        <button
          phx-click="load_more"
          class="px-6 py-3 bg-gray-800 hover:bg-gray-700 text-white font-semibold rounded-lg transition-colors border border-gray-700"
        >
          Load More Recipes
        </button>
      </div>
    <% end %>
  </main>

  <%= if @show_calendar_modal do %>
    <!-- Modal Backdrop -->
    <div
      class="fixed inset-0 bg-black/80 z-40"
      phx-click="close_modal"
    ></div>

    <!-- Modal -->
    <div class="fixed inset-x-4 top-1/2 -translate-y-1/2 md:inset-x-auto md:left-1/2 md:-translate-x-1/2 md:w-full md:max-w-md z-50">
      <div class="bg-gray-900 rounded-2xl shadow-2xl border border-gray-800">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-gray-800 flex items-center justify-between">
          <h3 class="text-xl font-bold">Add to Calendar</h3>
          <button
            phx-click="close_modal"
            class="p-2 hover:bg-gray-800 rounded-lg transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
          <p class="text-gray-400 text-sm mb-4">Select when you'd like to make this recipe:</p>

          <div class="space-y-3">
            <%= for date <- get_next_week_dates() do %>
              <div>
                <div class="text-xs font-semibold text-gray-500 mb-2 uppercase">
                  <%= Calendar.strftime(date, "%A, %B %d") %>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <%= for meal_type <- ["breakfast", "lunch", "dinner"] do %>
                    <button
                      phx-click="add_to_calendar"
                      phx-value-date={Date.to_iso8601(date)}
                      phx-value-meal-type={meal_type}
                      class="px-3 py-2 bg-gray-800 hover:bg-blue-600 rounded-lg text-sm font-medium transition-colors capitalize"
                    >
                      <%= meal_type %>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Steal Recipe Modal -->
  <%= if assigns[:show_steal_modal] && assigns[:generated_recipe] do %>
    <div
      class="fixed inset-0 bg-black/80 z-40"
      phx-click="close_steal_modal"
    ></div>

    <div class="fixed inset-x-2 top-4 bottom-4 md:inset-x-auto md:left-1/2 md:-translate-x-1/2 md:w-full md:max-w-2xl z-50 overflow-y-auto">
      <div class="bg-gray-900 rounded-2xl shadow-2xl border border-gray-800">
        <!-- Modal Header -->
        <div class="sticky top-0 px-6 py-4 border-b border-gray-800 flex items-center justify-between bg-gray-900 rounded-t-2xl">
          <div>
            <h3 class="text-xl font-bold"><%= @generated_recipe["title"] %></h3>
            <%= if @generated_recipe["source_restaurant"] do %>
              <p class="text-sm text-orange-400">Inspired by <%= @generated_recipe["source_restaurant"] %></p>
            <% end %>
          </div>
          <button
            phx-click="close_steal_modal"
            class="p-2 hover:bg-gray-800 rounded-lg transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
          <p class="text-gray-300 mb-6"><%= @generated_recipe["description"] %></p>

          <!-- Recipe Stats -->
          <div class="flex items-center gap-4 mb-6 text-sm text-gray-400">
            <%= if @generated_recipe["prep_time_minutes"] do %>
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>Prep: <%= @generated_recipe["prep_time_minutes"] %> min</span>
              </div>
            <% end %>
            <%= if @generated_recipe["cook_time_minutes"] do %>
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>Cook: <%= @generated_recipe["cook_time_minutes"] %> min</span>
              </div>
            <% end %>
            <%= if @generated_recipe["servings"] do %>
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span><%= @generated_recipe["servings"] %> servings</span>
              </div>
            <% end %>
          </div>

          <!-- Ingredients -->
          <div class="mb-6">
            <h4 class="font-bold text-lg mb-3">Ingredients</h4>
            <ul class="space-y-2">
              <%= for ingredient <- @generated_recipe["ingredients"] || [] do %>
                <li class="flex items-start gap-2 text-gray-300">
                  <span class="text-orange-500 mt-1">•</span>
                  <span>
                    <%= if ingredient["quantity"], do: "#{ingredient["quantity"]} " %>
                    <%= if ingredient["unit"], do: "#{ingredient["unit"]} " %>
                    <%= ingredient["name"] %>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>

          <!-- Instructions -->
          <div>
            <h4 class="font-bold text-lg mb-3">Instructions</h4>
            <ol class="space-y-4">
              <%= for {step, index} <- Enum.with_index(@generated_recipe["instructions"] || [], 1) do %>
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-orange-600 text-white text-sm flex items-center justify-center font-medium">
                    <%= index %>
                  </span>
                  <p class="text-gray-300"><%= step %></p>
                </li>
              <% end %>
            </ol>
          </div>

          <!-- Save Button -->
          <div class="mt-8 pt-6 border-t border-gray-800">
            <button class="w-full py-3 px-4 bg-orange-600 hover:bg-orange-500 text-white font-semibold rounded-lg transition-colors">
              Save to My Recipes
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Bottom Navigation with iOS safe area -->
  <nav class="mobile-nav bg-gray-900/95 backdrop-blur-lg border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center justify-around pt-2 pb-1">
        <!-- Feed -->
        <a href="/" class="flex flex-col items-center gap-1 text-blue-500 transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
          </svg>
          <span class="text-xs font-medium">Feed</span>
        </a>

        <!-- Saved -->
        <%= live_redirect to: "/recipes/saved", class: "flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <span class="text-xs font-medium">Saved</span>
        <% end %>

        <!-- Calendar -->
        <%= live_redirect to: "/calendar", class: "flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="text-xs font-medium">Calendar</span>
        <% end %>

        <!-- Groceries -->
        <%= live_redirect to: "/groceries", class: "flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <span class="text-xs font-medium">Groceries</span>
        <% end %>

        <!-- Profile -->
        <%= live_redirect to: "/users/settings", class: "flex flex-col items-center gap-1 text-gray-400 hover:text-white transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <span class="text-xs font-medium">Profile</span>
        <% end %>
      </div>
    </div>
  </nav>

  <!-- Bottom Padding for Nav (handled by mobile-content class) -->
  <div class="mobile-content"></div>
</div>
